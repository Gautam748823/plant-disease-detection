# Large Training Data (DON'T UPLOAD - too large for GitHub)
data/PlantVillage_Dataset/
data/*.zip
data/*.tar.gz
data/raw/
data/processed/

# Keep data folder structure but not the large dataset
!data/README.md
!data/.gitkeep

# Model files
# IMPORTANT: If your model file is > 100MB, it won't upload to GitHub
# Option 1: Keep this line to exclude models (upload to Google Drive instead)
models/*.h5
models/*.keras
models/*.hdf5

# Option 2: If model is < 100MB, comment out the lines above and uncomment below:
# !models/plant_disease_model_compatible.h5
# !models/class_labels.json

# Keep model folder structure
!models/README.md
!models/.gitkeep

# Notebooks - Keep checkpoints out
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Training outputs (images, plots)
# Keep screenshots but not training results
results/
outputs/
*.png
*.jpg
*.jpeg
*.gif

# Allow specific folders for screenshots/documentation
!screenshots/*.png
!screenshots/*.jpg
!docs/images/*.png
!static/images/*

